<?xml version="1.0"?>
<sdf version="1.6">
  <model name="fixed_color_camera_test">
    <static>true</static>
    <pose>0 0 1 0 0 0</pose>

    <link name="camera_link">
      <sensor name="color_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>

        <camera>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
        </camera>

        <plugin name="gazebo_ros_camera"
                filename="/opt/ros/humble/lib/libgazebo_ros_camera.so">
          <ros>
            <namespace>/fixed_camera</namespace>
          </ros>
          <camera_name>color_camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
